import google.auth
import requests
import json

PROJECT_ID = "your-gcp-project"
LOCATION = "us-central1"
MODEL = "gemini-1.5-pro"

# --------------------------------------------------
# Get default credentials from Composer / GCP
# --------------------------------------------------
credentials, _ = google.auth.default(scopes=[
    "https://www.googleapis.com/auth/cloud-platform"
])

# Get access token automatically
auth_req = google.auth.transport.requests.Request()
credentials.refresh(auth_req)
access_token = credentials.token

# --------------------------------------------------
# Vertex AI REST endpoint
# --------------------------------------------------
url = f"https://{LOCATION}-aiplatform.googleapis.com/v1/projects/{PROJECT_ID}/locations/{LOCATION}/publishers/google/models/{MODEL}:generateContent"

def instruction_to_sql(user_instruction: str, table_schema: str):

    prompt = f"""
    You are a BigQuery SQL expert.

    Table schema:
    {table_schema}

    User instruction:
    {user_instruction}

    Convert the above instruction into valid BigQuery SQL.
    Return ONLY the SQL.
    """

    payload = {
        "contents": [
            {
                "role": "user",
                "parts": [{"text": prompt}]
            }
        ]
    }

    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json"
    }

    response = requests.post(url, headers=headers, json=payload)
    response_json = response.json()

    # Extract text from response
    sql_output = response_json["candidates"][0]["content"]["parts"][0]["text"]
    return sql_output

# ---------------- Example ----------------
if __name__ == "__main__":

    bq_schema = """
    Table: airflow_dag_runs
    Columns:
      - dag_id STRING
      - state STRING
      - start_date TIMESTAMP
      - end_date TIMESTAMP
      - duration_seconds FLOAT
    """

    instruction = "Get latest status of dag sales_pipeline"

    sql = instruction_to_sql(instruction, bq_schema)

    print("\nGenerated SQL:\n")
    print(sql)