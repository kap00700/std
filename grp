from google.cloud import aiplatform
import google.auth
from google.auth import impersonated_credentials

PROJECT_ID = "your-gcp-project"
LOCATION = "us-central1"

# --------------------------------------------------
# 1) Get default credentials from Composer / GCP
# --------------------------------------------------
base_creds, project = google.auth.default()

# --------------------------------------------------
# 2) Impersonate another service account (optional)
# --------------------------------------------------
TARGET_SA = "your-target-sa@your-gcp-project.iam.gserviceaccount.com"

creds = impersonated_credentials.Credentials(
    source_credentials=base_creds,
    target_principal=TARGET_SA,
    target_scopes=["https://www.googleapis.com/auth/cloud-platform"],
    lifetime=3600
)

# --------------------------------------------------
# 3) Initialize Vertex AI with these credentials
# --------------------------------------------------
aiplatform.init(
    project=PROJECT_ID,
    location=LOCATION,
    credentials=creds
)

# Load model
model = aiplatform.GenerativeModel("gemini-1.5-pro")

def instruction_to_sql(user_instruction: str, table_schema: str) -> str:
    prompt = f"""
    You are a BigQuery SQL expert.

    Table schema:
    {table_schema}

    User instruction:
    {user_instruction}

    Convert the above instruction into valid BigQuery SQL.
    Return ONLY the SQL.
    """

    response = model.generate_content(prompt)
    return response.text


# ------------- Example Run ----------------
if __name__ == "__main__":

    bq_schema = """
    Table: airflow_dag_runs
    Columns:
      - dag_id STRING
      - state STRING
      - start_date TIMESTAMP
      - end_date TIMESTAMP
      - duration_seconds FLOAT
    """

    instruction = "Get latest status of dag sales_pipeline"

    sql = instruction_to_sql(instruction, bq_schema)

    print("\nGenerated SQL:\n")
    print(sql)